# AWS S3 Font Storage (server-side only, used by prebuild script)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=your_bucket_name
AWS_REGION=us-east-1

# --- Midnight fork settings (see README section "Midnight fork") ---

# GraphQL endpoint of the scraper's Hasura instance. Defaults to Hyperlane's
# hosted API, which has no Midnight data.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080/v1/graphql

# Registry carrying the midnight chain entry and the NIGHT warp route
# (chain metadata, addresses, logos). Upstream mechanism, no fork code.
NEXT_PUBLIC_REGISTRY_URL=https://github.com/equilibriumco/hyperlane-registry
NEXT_PUBLIC_REGISTRY_BRANCH=midnight-v1
